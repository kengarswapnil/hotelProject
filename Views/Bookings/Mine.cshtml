@model List<Booking>
@{ ViewData["Title"] = "My bookings"; var today = AvailabilityService.Today; }
<h1 class="h3 mb-3">My bookings</h1>
@if (!Model.Any())
{
    <div class="alert alert-info">You have no bookings yet. <a asp-controller="Rooms" asp-action="Search">Find a room</a>.</div>
}
<div class="row g-3">
@foreach (var b in Model)
{
    <div class="col-12 col-md-6">
        <div class="card h-100"><div class="card-body">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="fw-semibold">@b.Room!.RoomType!.Name</div>
                    <div class="small text-muted">Ref @b.Reference - Room @b.Room.RoomNumber</div>
                </div>
                <span class="badge @Ui.Badge(b.Status)">@b.Status</span>
            </div>
            <div class="my-2 small"><i class="bi bi-calendar-event me-1"></i>@Ui.D(b.CheckIn) to @Ui.D(b.CheckOut) (@b.Nights nights)</div>
            <div class="fw-semibold mb-3">@Ui.Money(b.TotalPrice)</div>
            <a class="btn btn-outline-primary btn-sm" asp-action="Details" asp-route-id="@b.Id">Details</a>
            @if (b.Status == BookingStatus.Confirmed && b.CheckIn > today)
            {
                <form method="post" asp-action="Cancel" asp-route-id="@b.Id" class="d-inline"
                      onsubmit="return confirm('Cancel this booking?');">
                    <button class="btn btn-outline-danger btn-sm" type="submit">Cancel</button>
                </form>
            }
        </div></div>
    </div>
}
</div>
