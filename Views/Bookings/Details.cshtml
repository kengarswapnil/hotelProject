@model Booking
@{ ViewData["Title"] = "Booking " + Model.Reference; }
<div class="row justify-content-center"><div class="col-lg-7">
<div class="card card-body">
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div><h1 class="h4 mb-0">Booking @Model.Reference</h1><div class="small text-muted">Booked on @Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</div></div>
        <span class="badge @Ui.Badge(Model.Status)">@Model.Status</span>
    </div>
    <dl class="row mb-0">
        <dt class="col-5">Guest</dt><dd class="col-7">@Model.User?.FullName</dd>
        <dt class="col-5">Room</dt><dd class="col-7">@Model.Room!.RoomType!.Name (Room @Model.Room.RoomNumber, floor @Model.Room.Floor)</dd>
        <dt class="col-5">Check-in</dt><dd class="col-7">@Ui.D(Model.CheckIn)</dd>
        <dt class="col-5">Check-out</dt><dd class="col-7">@Ui.D(Model.CheckOut)</dd>
        <dt class="col-5">Nights</dt><dd class="col-7">@Model.Nights</dd>
        <dt class="col-5">Guests</dt><dd class="col-7">@Model.Guests</dd>
        <dt class="col-5">Rate</dt><dd class="col-7">@Ui.Money(Model.PricePerNight) / night</dd>
        <dt class="col-5">Total</dt><dd class="col-7 fw-bold">@Ui.Money(Model.TotalPrice)</dd>
        @if (!string.IsNullOrEmpty(Model.Notes))
        {
            <dt class="col-5">Requests</dt><dd class="col-7">@Model.Notes</dd>
        }
    </dl>
    <div class="mt-3">
        @if (User.IsInRole("Admin")) { <a class="btn btn-outline-secondary" asp-controller="AdminBookings" asp-action="Index">Back to bookings</a> }
        else { <a class="btn btn-outline-secondary" asp-action="Mine">Back to my bookings</a> }
    </div>
</div></div></div>
