@model BookingFilterVm
@{ ViewData["Title"] = "Manage bookings"; }
<h1 class="h3 mb-3">Bookings</h1>
<form method="get" class="row g-2 mb-3">
    <div class="col-12 col-md-5"><input name="q" value="@Model.Q" class="form-control" placeholder="Search reference, guest, email or room no." /></div>
    <div class="col-8 col-md-4">
        <select name="status" class="form-select">
            <option value="">All statuses</option>
            @foreach (var s in Enum.GetValues<BookingStatus>())
            {
                <option value="@s" selected="@(Model.Status == s)">@s</option>
            }
        </select>
    </div>
    <div class="col-4 col-md-3"><button class="btn btn-primary w-100" type="submit">Filter</button></div>
</form>
<div class="card"><div class="table-responsive">
<table class="table table-hover mb-0">
    <thead class="table-light"><tr><th>Ref</th><th>Guest</th><th>Room</th><th>Dates</th><th>Total</th><th>Status</th><th></th></tr></thead>
    <tbody>
    @foreach (var b in Model.Bookings)
    {
        <tr>
            <td><a asp-controller="Bookings" asp-action="Details" asp-route-id="@b.Id">@b.Reference</a></td>
            <td>@b.User?.FullName<div class="small text-muted">@b.User?.Email</div></td>
            <td>@b.Room!.RoomNumber <span class="small text-muted">@b.Room.RoomType?.Name</span></td>
            <td class="text-nowrap">@Ui.D(b.CheckIn) - @Ui.D(b.CheckOut)</td>
            <td>@Ui.Money(b.TotalPrice)</td>
            <td><span class="badge @Ui.Badge(b.Status)">@b.Status</span></td>
            <td class="text-end text-nowrap">
                @if (b.Status == BookingStatus.Confirmed)
                {
                    <form method="post" asp-action="SetStatus" asp-route-id="@b.Id" class="d-inline">
                        <input type="hidden" name="q" value="@Model.Q" /><input type="hidden" name="status" value="@Model.Status" />
                        <button name="newStatus" value="CheckedIn" class="btn btn-success btn-sm">Check in</button>
                        <button name="newStatus" value="Cancelled" class="btn btn-outline-danger btn-sm" onclick="return confirm('Cancel this booking?');">Cancel</button>
                    </form>
                }
                else if (b.Status == BookingStatus.CheckedIn)
                {
                    <form method="post" asp-action="SetStatus" asp-route-id="@b.Id" class="d-inline">
                        <input type="hidden" name="q" value="@Model.Q" /><input type="hidden" name="status" value="@Model.Status" />
                        <button name="newStatus" value="Completed" class="btn btn-secondary btn-sm">Check out</button>
                    </form>
                }
            </td>
        </tr>
    }
    @if (!Model.Bookings.Any()) { <tr><td colspan="7" class="text-center text-muted py-4">No bookings found.</td></tr> }
    </tbody>
</table>
</div></div>
