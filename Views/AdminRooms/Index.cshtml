@model List<Room>
@{ ViewData["Title"] = "Rooms"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Rooms</h1>
    <a class="btn btn-accent" asp-action="Create"><i class="bi bi-plus-lg me-1"></i>Add room</a>
</div>
<div class="card"><div class="table-responsive">
<table class="table table-hover mb-0">
    <thead class="table-light"><tr><th>Room</th><th>Floor</th><th>Type</th><th>Status</th><th></th></tr></thead>
    <tbody>
    @foreach (var r in Model)
    {
        <tr>
            <td class="fw-semibold">@r.RoomNumber</td>
            <td>@r.Floor</td>
            <td>@r.RoomType?.Name</td>
            <td>@if (r.IsActive) { <span class="badge text-bg-success">Active</span> } else { <span class="badge text-bg-secondary">Inactive</span> }</td>
            <td class="text-end text-nowrap">
                <a class="btn btn-outline-primary btn-sm" asp-action="Edit" asp-route-id="@r.Id">Edit</a>
                <form method="post" asp-action="Delete" asp-route-id="@r.Id" class="d-inline" onsubmit="return confirm('Delete room @(r.RoomNumber)?');">
                    <button class="btn btn-outline-danger btn-sm" type="submit">Delete</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
</div></div>
